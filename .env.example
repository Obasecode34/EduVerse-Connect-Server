PORT=5000
NODE_ENV=development

MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/eduverse-connect

# Keep these two DIFFERENT secrets. Rotating the refresh secret alone
# invalidates all refresh tokens without killing active access tokens.
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh

JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

CORS_ORIGIN=http://localhost:5173

# Only used by scripts/seedAdmin.js — safe to leave unset and pass args
# on the command line instead: npm run seed:admin -- you@example.com pass123 "Your Name"
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
